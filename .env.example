# copy to .env, fill in, never commit
OPENAI_API_KEY=replace-with-your-provider-api-key
OPENAI_BASE_URL=https://tokens.bd/v1
# Use server-sent streaming to avoid idle timeouts on compatible gateways.
OPENAI_STREAM=true
# Raise if the provider/model supports it and a response ends with finish_reason=length.
OPENAI_MAX_TOKENS=128000
# Request timeout can also be set per command with --timeout-seconds.
LLM_TIMEOUT_SECONDS=600
DERIVATION_MODEL=qwen/qwen-3.7-plus
DERIVATION_REASONING_EFFORT=
AUDIT_MODEL=claude-haiku-5-5
AUDIT_REASONING_EFFORT=
# Both roles use OPENAI_API_KEY and OPENAI_BASE_URL above.
# Set DERIVATION_API_KEY / DERIVATION_BASE_URL or AUDIT_API_KEY / AUDIT_BASE_URL
# only when a role needs different credentials or an endpoint.
MAX_STEP_RETRIES=3
STREAMING_ENABLED=true
